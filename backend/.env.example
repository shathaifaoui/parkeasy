# Copiez ce fichier en ".env" et adaptez-le à votre installation PostgreSQL.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
# La base est créée automatiquement au premier lancement si elle n'existe pas
PGDATABASE=parkeasy

PORT=3000
JWT_SECRET=changez-moi-en-production

# Fuseau horaire des horaires d'ouverture et du « jour » du tableau de bord
APP_TIMEZONE=Africa/Tunis
