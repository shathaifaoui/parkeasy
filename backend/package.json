{
  "name": "parkeasy-backend",
  "version": "1.0.0",
  "description": "API REST ParkEasy (Express + PostgreSQL)",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/api.test.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "reset-db": "node src/server.js --reset",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"database/**/*.js\"",
    "start:prod": "node src/server.js --prod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.10.1"
  }
}
